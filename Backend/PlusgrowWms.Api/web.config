<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet" arguments=".\PlusgrowWms.Api.dll" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" hostingModel="inprocess" />
      
      <!-- Remove any IIS-level CORS headers to let ASP.NET Core handle CORS -->
      <httpProtocol>
        <customHeaders>
          <remove name="Access-Control-Allow-Origin" />
          <remove name="Access-Control-Allow-Methods" />
          <remove name="Access-Control-Allow-Headers" />
        </customHeaders>
      </httpProtocol>
    </system.webServer>
  </location>
</configuration>
